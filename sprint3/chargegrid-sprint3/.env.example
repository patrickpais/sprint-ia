# Copie este arquivo para ".env" e preencha com suas chaves reais.
# NUNCA commitar o .env (ele já está no .gitignore).

# Obrigatório - usado pelo modelo principal e embeddings
OPENAI_API_KEY=sk-...

# Necessário para rodar a comparação com um segundo modelo (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional - observabilidade/tracing das execuções do LangGraph
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=

# Modelo principal usado em produção (pode trocar para comparar)
GOODWE_MODEL_PROVIDER=openai
GOODWE_MODEL_NAME=gpt-4o-mini
